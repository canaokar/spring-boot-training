POST http://localhost:8080/api/questions
Content-Type: application/json

{
  "questionText": "What is the capital of Japan?",
  "optionA": "Beijing",
  "optionB": "Seoul",
  "optionC": "Tokyo",
  "optionD": "Bangkok",
  "correctOption": "C",
  "category": "Geography"
}


